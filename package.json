{
  "name": "qtconfigure-enhanced",
  "displayName": "QtConfigure Enhanced",
  "description": "Generating configuration files for Qt project in VSCode",
  "version": "0.6.4",
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:qtConfigure.newQtProject",
    "onCommand:qtConfigure.setQtDir",
    "onCommand:qtConfigure.openQtDesigner",
    "onCommand:qtConfigure.openQtAssistant",
    "onCommand:qtConfigure.openQtHelp",
    "onCommand:qtConfigure.rebuildQtHelpIndex",
    "onCustomEditor:qtConfigure.uiDesignerView",
    "workspaceContains:**/*.ui"
  ],
  "publisher": "nzp0110",
  "keywords": [
    "qt",
    "qtconfigure",
    "qtconfigure-enhanced"
  ],
  "icon": "image/VSCodeQtConfigurator.ico",
  "main": "./out/extension.js",
  "homepage": "https://github.com/nzp0110/QtConfigure-Enhanced",
  "bugs": {
    "url": "https://github.com/nzp0110/QtConfigure-Enhanced/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nzp0110/QtConfigure-Enhanced"
  },
  "contributes": {
    "commands": [
      {
        "command": "qtConfigure.newQtProject",
        "title": "QtConfigure : New Project"
      },
      {
        "command": "qtConfigure.setQtDir",
        "title": "QtConfigure : Set Qt Dir"
      },
      {
        "command": "qtConfigure.openQtDesigner",
        "title": "QtConfigure : Open Qt Designer"
      },
      {
        "command": "qtConfigure.openQtAssistant",
        "title": "QtConfigure : Open Qt Assistant"
      },
      {
        "command": "qtConfigure.openQtHelp",
        "title": "QtConfigure : Show Qt Help",
        "category": "QtConfigure"
      },
      {
        "command": "qtConfigure.rebuildQtHelpIndex",
        "title": "QtConfigure : Rebuild Qt Help Index",
        "category": "QtConfigure"
      },
      {
        "command": "qtConfigure.helpBack",
        "title": "QtConfigure : Qt Help Back",
        "category": "QtConfigure"
      },
      {
        "command": "qtConfigure.helpForward",
        "title": "QtConfigure : Qt Help Forward",
        "category": "QtConfigure"
      }
    ],
    "keybindings": [
      {
        "command": "qtConfigure.openQtHelp",
        "key": "f1",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c || editorLangId == cpp-pch || editorLangId == cuda-cpp)"
      },
      {
        "command": "qtConfigure.openQtHelp",
        "key": "shift+f1",
        "when": "editorTextFocus"
      },
      {
        "command": "qtConfigure.helpBack",
        "key": "ctrl+left",
        "when": "activeWebviewPanelId == qtConfigure.help"
      },
      {
        "command": "qtConfigure.helpForward",
        "key": "ctrl+right",
        "when": "activeWebviewPanelId == qtConfigure.help"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "qtConfigure.openQtHelp",
          "when": "editorLangId == cpp || editorLangId == c || editorLangId == cuda-cpp",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "qtConfigure.openQtDesigner",
          "when": "resourceExtname =~ /\\.ui$/i",
          "group": "navigation@40"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "qtConfigure.uiDesignerView",
        "displayName": "Qt Designer",
        "selector": [
          {
            "filenamePattern": "*.ui"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Qt Configure",
      "properties": {
        "qtConfigure.qtDir": {
          "type": "string",
          "default": "",
          "description": "Qt 安装路径 (Qt installation path)"
        },
        "qtConfigure.vcvarsallPath": {
          "type": "string",
          "default": "C:\\Program Files (x86)\\Microsoft Visual Studio\\__VS_VERSION__\\Community\\VC\\Auxiliary\\Build\\vcvarsall.bat",
          "description": "Visual Studio vcvarsall.bat (配置环境变量、工作目录批处理文件) 路径。 (Visual studio vcvarsall.bat (configuration environment variables, working directory, batch file) path)"
        },
        "qtConfigure.mingwPath": {
          "type": "string",
          "default": "",
          "description": "MinGW 安装路径，需要到 bin 之前的那个目录，此值未设置时会在配置 Qt 安装路径后自动设置为 Qt 自带的 MinGW 路径 (The MinGW installation path needs to go to the directory before bin. If this value is not set, it will be automatically set to the MinGW path of Qt after configuring the Qt installation path)"
        },
        "qtConfigure.qtKitDir": {
          "type": "string",
          "default": "",
          "description": "Qt 套件路径 (Qt Kit path)"
        },
        "qtConfigure.qtHelpPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "存放 Qt 帮助文档 (.qch) 的目录。留空时自动从 Qt 安装路径下的 Docs 目录查找 (Directories containing Qt documentation (.qch) files. When empty, the Docs directory under the Qt installation path is used)"
        },
        "qtConfigure.qtHelpViewMode": {
          "type": "string",
          "enum": [
            "panel",
            "browser"
          ],
          "enumDescriptions": [
            "在 VS Code 侧边的面板中打开，跟随编辑器主题 (Open in a panel beside the editor, follows the editor theme)",
            "用系统默认浏览器打开本地帮助页，可在浏览器里自由跳转 (Open in the system default browser, free to navigate there)"
          ],
          "default": "panel",
          "markdownDescription": "按 F1 查看 Qt 帮助时的展示方式 (How to display Qt help when pressing F1)\n\n- `panel`：VS Code 侧边面板（Webview），不离开编辑器\n- `browser`：系统默认浏览器，跨模块链接更完整"
        },
        "qtConfigure.designerAutoOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "打开后，双击 .ui 文件不再进入文本编辑器，而是显示占位视图并自动用 Qt Designer 打开 (When enabled, double-clicking a .ui file shows a placeholder view instead of the text editor and opens it with Qt Designer automatically)\n\n开启时会向用户设置 `workbench.editorAssociations` 添加 `*.ui` 与本扩展的关联，关闭时移除该关联 (Enabling adds a `*.ui` association to this extension in the user setting `workbench.editorAssociations`; disabling removes it)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "1.63.0",
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.2.2",
    "@types/node": "14.x",
    "eslint": "^7.27.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "glob": "^7.1.7",
    "mocha": "^8.4.0",
    "typescript": "^4.3.2",
    "vscode-test": "^1.5.2"
  }
}
